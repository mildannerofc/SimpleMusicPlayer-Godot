{
  "name": "simple-music-player",
  "version": "1.0.0",
  "description": "Player de música simples em Godot 4.7, portado de um projeto PenguinMod/Scratch.",
  "private": true,
  "keywords": ["godot", "godot4", "gdscript", "music-player", "scratch", "penguinmod"],
  "scripts": {
    "start": "godot --path .",
    "editor": "godot --editor --path .",
    "import": "godot --headless --path . --import --quit"
  },
  "engines": {
    "godot": ">=4.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mildannerofc/simple-music-player.git"
  },
  "license": "UNLICENSED"
}
